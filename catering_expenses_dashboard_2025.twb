      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0a2bngp012pscp10tgxmz126x72l].[sum:fact_amount:qk]&quot;' value='Факт' />
          <alias key='&quot;[federated.0a2bngp012pscp10tgxmz126x72l].[sum:fact_minus_plan:qk]&quot;' value='Δ' />
          <alias key='&quot;[federated.0a2bngp012pscp10tgxmz126x72l].[sum:plan_amount:qk]&quot;' value='План' />
        </aliases>
      </column>
      <column caption='Заказ выше плана число' datatype='integer' name='[Calculation_0303198736838665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_over_plan] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Фильтр режим год' datatype='boolean' name='[Calculation_0303198745415690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Год&quot;' />
      </column>
      <column caption='Фильтр events месяц' datatype='boolean' name='[Calculation_0303198750822411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Месяц&quot;&#13;&#10;AND [month_name_ru] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Фильтр staff месяц' datatype='boolean' name='[Calculation_0303198752591884]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Месяц&quot;&#13;&#10;AND DATEPART(&apos;month&apos;, [event_date (staff!for!tableau)]) =&#13;&#10;    CASE [Parameters].[Parameter 2]&#13;&#10;        WHEN &quot;январь&quot; THEN 1&#13;&#10;        WHEN &quot;февраль&quot; THEN 2&#13;&#10;        WHEN &quot;март&quot; THEN 3&#13;&#10;        WHEN &quot;апрель&quot; THEN 4&#13;&#10;        WHEN &quot;май&quot; THEN 5&#13;&#10;        WHEN &quot;июнь&quot; THEN 6&#13;&#10;        WHEN &quot;июль&quot; THEN 7&#13;&#10;        WHEN &quot;август&quot; THEN 8&#13;&#10;        WHEN &quot;сентябрь&quot; THEN 9&#13;&#10;        WHEN &quot;октябрь&quot; THEN 10&#13;&#10;        WHEN &quot;ноябрь&quot; THEN 11&#13;&#10;        WHEN &quot;декабрь&quot; THEN 12&#13;&#10;    END' />
      </column>
      <column caption='Фильтр events период' datatype='boolean' name='[Calculation_0303198753824781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Год&quot;&#13;&#10;OR [month_name_ru] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Цвет факта' datatype='string' name='[Calculation_0680056577576960]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([fact_amount]) &gt; SUM([plan_amount]) THEN&#13;&#10;    &quot;Превышение&quot;&#13;&#10;ELSE&#13;&#10;    &quot;В плане&quot;&#13;&#10;END' />
      </column>
      <column caption='Показать год' datatype='boolean' name='[Calculation_0680056585826305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Год&quot;' />
      </column>
      <column caption='Показать месяц' datatype='boolean' name='[Calculation_0680056585916418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Месяц&quot;' />
      </column>
      <column caption='В плане' datatype='integer' name='[Calculation_0680056596795395]' role='measure' type='quantitative'>
